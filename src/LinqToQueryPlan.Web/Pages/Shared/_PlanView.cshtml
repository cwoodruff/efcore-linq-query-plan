@model CapturedPlan
@{
    var nodes = Model.Parsed.AllNodes().ToList();
    var maxRows = nodes.Count == 0 ? 1 : nodes.Max(n => Math.Max(n.EstRowsTotal, n.ActualRows ?? 0));
    var stmtId = "t" + Guid.NewGuid().ToString("n")[..8];
}
<div class="plan">
    <div class="panel-title">What the optimizer saw <span class="muted" style="font-weight:400">(cached plan for this statement)</span></div>
    <div class="plan-head">
        <span class="badge @(Model.IsActual ? "good" : "")">@(Model.IsActual ? "last actual plan" : "estimated plan")</span>
        <span class="badge @(Model.CompiledForThisRun ? "good" : "warn")">@(Model.CompiledForThisRun ? "compiled for this run" : $"reused, compiled {Model.CreationTime:HH:mm:ss}")</span>
        @if (Model.Parsed.PlanPerValueHint is not null)
        {
            <span class="badge accent" title="@Model.Parsed.PlanPerValueHint">PSP query variant</span>
        }
        <span class="badge">@Model.ExecutionCount.ToString("N0") execution@(Model.ExecutionCount == 1 ? "" : "s")</span>
        <span class="badge">@Model.LastLogicalReads.ToString("N0") reads</span>
        <span class="badge">@Model.LastRows.ToString("N0") rows</span>
        <span class="badge">cost @Model.Parsed.TotalCost.ToString("0.###")</span>
        @if (Model.Parsed.CardinalityModel is not null)
        {
            <span class="badge" title="Cardinality estimation model version">CE @Model.Parsed.CardinalityModel</span>
        }
        <span class="spacer"></span>
        <a class="btn secondary small" href="/plans/@(Model.Id).sqlplan" title="Open in VS Code (MSSQL extension) or SSMS">Download .sqlplan</a>
    </div>

    @if (Model.Parsed.Parameters.Count > 0)
    {
        <div class="table-wrap" style="margin-bottom:0.6rem">
            <table class="grid params">
                <thead><tr><th>Parameter</th><th>Type</th><th>Compiled for (sniffed)</th><th>This run</th></tr></thead>
                <tbody>
                    @foreach (var p in Model.Parsed.Parameters)
                    {
                        <tr>
                            <td><code>@p.Name</code></td>
                            <td>@p.DataType</td>
                            <td><code>@p.CompiledValue</code></td>
                            <td>@(p.RuntimeValue is null ? Html.Raw("<span class=\"muted\">see SQL above</span>") : Html.Raw($"<code>{System.Net.WebUtility.HtmlEncode(p.RuntimeValue)}</code>"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.Parsed.Root is { } root)
    {
        ViewData["maxRows"] = maxRows;
        <ul class="plan-tree">
            <partial name="_PlanNode" model="root" view-data="ViewData" />
        </ul>
        <div class="legend">
            <span class="l-cost">share of estimated cost</span>
            <span class="l-est">estimated rows</span>
            @if (Model.IsActual)
            {
                <span class="l-act">actual rows</span>
            }
            <span>bars are log scale</span>
        </div>
    }

    @foreach (var w in Model.Parsed.Warnings)
    {
        <p class="admin-note" style="margin-top:0.5rem">Plan warning: @w</p>
    }

    <details class="log" style="margin-top:0.6rem">
        <summary>Statement text in the plan cache</summary>
        <div class="code-wrap">
            <button type="button" class="tool copy" data-copy="@stmtId">Copy</button>
            <pre><code id="@stmtId" class="language-sql">@Model.Parsed.StatementText</code></pre>
        </div>
    </details>
</div>
