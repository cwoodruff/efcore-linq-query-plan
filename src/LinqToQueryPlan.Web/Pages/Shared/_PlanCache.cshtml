@model List<PlanCacheGroup>
@{
    var chart = Model.Count == 0 ? null : new ChartSpec
    {
        Title = "Cached plans per tag",
        Labels = Model.Select(g => g.TagLine).ToList(),
        Series = [new("cached plans", Model.Select(g => (double)g.CachedPlans).ToList())],
        YTitle = "plans",
    };
}
<div class="card stack">
    <div class="panel-title">Plan cache <span class="muted" style="font-weight:400">sys.dm_exec_cached_plans, grouped by TagWith comment (scripts/02)</span></div>
    @if (Model.Count == 0)
    {
        <p class="muted">Nothing cached for this demo's tag yet. Run an action first.</p>
    }
    else
    {
        <div class="chart"><canvas id="@chart!.Id"></canvas></div>
        <script>lab.chart('@chart.Id', @Html.Raw(Ui.ChartJson(chart)));</script>
        <div class="table-wrap">
            <table class="grid">
                <thead><tr><th>Tag</th><th class="num">Cached plans</th><th class="num">Uses</th><th class="num">KB</th><th>Type</th></tr></thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        <tr><td><code>@g.TagLine</code></td><td class="num">@g.CachedPlans</td><td class="num">@g.TotalUses</td><td class="num">@g.TotalKb.ToString("N0")</td><td>@g.ObjTypes</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted" style="font-size:0.85rem">Parameter Sensitive Plan variants don't carry your tag comment, so they are not counted here. The Query Store view links them back to the tagged parent.</p>
    }
    <button class="btn secondary small" hx-get="?handler=PlanCache" hx-target="#server-panel">Refresh</button>
</div>
